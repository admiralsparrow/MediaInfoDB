# Database
# By default, PostgreSQL runs inside the container.
# To use an external database, uncomment and set DATABASE_URL:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/mediainfodb

# Internal DB settings (ignored when DATABASE_URL is set)
DB_PASSWORD=mediainfo_dev #changeme
POSTGRES_DB=mediainfodb
POSTGRES_USER=mediainfodb

# Persistent storage for internal DB (host path or named volume)
DB_DATA_PATH=/path/to/postgres/data

# Media library paths (mount as many as needed)
MOVIES=/path/to/movies 
TV=/path/to/tv

# Folder browser security - comma-separated allowed roots inside container
ALLOWED_BROWSE_ROOTS=/media

# Scanning schedule (minutes between automatic re-scans, 0 to disable)
SCAN_INTERVAL_MINUTES=360
